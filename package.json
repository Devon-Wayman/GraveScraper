{
  "name": "gravescraper-node-express",
  "version": "3.6.0",
  "description": "Localized grave management system.",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node src/server.js",
    "dev": "node --watch-path=src/server.js src/server.js",
    "electron": "electron .",
    "clean:dist": "node scripts/clean-dist.js",
    "electron:dist": "electron-builder --publish never && node scripts/clean-dist.js",
    "electron:dist:mac": "electron-builder --mac --publish never && node scripts/verify-packaged-mac.js && node scripts/clean-dist.js",
    "verify:packaged:mac": "node scripts/verify-packaged-mac.js",
    "electron:dist:win": "electron-builder --win --publish never && node scripts/clean-dist.js",
    "electron:dist:win:x64": "electron-builder --win --x64 --publish never && node scripts/clean-dist.js",
    "electron:dist:linux": "electron-builder --linux --publish never && node scripts/clean-dist.js"
  },
  "keywords": [
    "express",
    "sqlite",
    "findagrave"
  ],
  "author": "Devon Wayman",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "heic-decode": "^2.1.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^35.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gravescraper.desktop",
    "productName": "GraveScraper",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
